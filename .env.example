# Copy to .env (never commit .env)

# One of: ollama | openai | anthropic | gemini
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:8b
MOCK_LLM=false
OLLAMA_BASE_URL=http://localhost:11434

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
GEMINI_API_KEY=

DUCKDB_PATH=data/allocation.duckdb
# Due dates must fall after this date (Section 4.5)
PLANNING_START=2026-10-12
